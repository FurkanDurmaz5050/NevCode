# Frontend için public env değişkenleri.
# `cp .env.local.example .env.local` ile kopyala.
# UYARI: Buraya OpenAI veya başka herhangi bir secret yazma — bunlar bundle'a sızar.
# Tüm secret'lar supabase/functions/.env içine konur ve edge function'lardan kullanılır.

# Local supabase stack için varsayılanlar (`supabase start` çıktısından alabilirsin):
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...replace-with-local-anon-key

# Production: kendi Supabase projenin URL ve anon key'ini koy
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...
