# supabase/functions/.env.example
# `cp supabase/functions/.env.example supabase/functions/.env` ile kopyala ve doldur.
# Local: `supabase functions serve --env-file supabase/functions/.env`
# Prod : `supabase secrets set --env-file supabase/functions/.env`

# === ZORUNLU ===
OPENAI_API_KEY=sk-proj-...

# === FAZ 1: opsiyonel web search ===
TAVILY_API_KEY=

# === FAZ 2: Remotion render ===
# YOL A — Generic webhook (kendi render server'ın):
REMOTION_RENDER_WEBHOOK=
REMOTION_RENDER_WEBHOOK_TOKEN=
# YOL B — AWS Lambda (Remotion Lambda deploy):
REMOTION_LAMBDA_INVOKE_URL=
REMOTION_LAMBDA_FUNCTION_NAME=
REMOTION_SERVE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
# Edge function callback URL'i (yoksa SUPABASE_URL/functions/v1 kullanılır):
PUBLIC_FUNCTIONS_URL=

# === FAZ 3 (kullanıcı kendi yapacak): ElevenLabs + Twilio ===
ELEVENLABS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# === FAZ 4: Lojistik & Karbon (opsiyonel — yoksa tahmin fallback) ===
# Shippo (https://goshippo.com) — gerçek hava kargo kotaları:
SHIPPO_TOKEN=
# Climatiq (https://climatiq.io) — gerçek karbon emisyonu:
CLIMATIQ_API_KEY=
# FX: exchangerate.host anahtarsız — buraya bir şey yazma.

# === GEMINI: görsel üretimi (gemini-image, social-posts) ===
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TEXT_MODEL=gemini-2.5-flash

# OpenAI varsayılan modeli
OPENAI_MODEL=gpt-5.5
